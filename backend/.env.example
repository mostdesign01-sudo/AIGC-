# ---- 创意站（必看）----
# 写接口（POST /api/v1/creative/ingest、PUT .../weeks/{week}/top3、PUT .../labels）的口令；为空则写接口关闭
ADMIN_TOKEN=
# 内容目录，默认仓库根 content/。部署到有持久盘的平台时可改成挂载路径
# CONTENT_DIR=/data/content
# 每次写入后同步落盘的 feed.json，默认 frontend/src/data/feed.json；只读文件系统会自动跳过
# FEED_PATH=
# ffmpeg 路径（可选，仅 scripts/make_gifs.py 用；也可用 FFMPEG_PATH / FFPROBE_PATH）
# FFMPEG_PATH=

# ---- 旧版爬虫 / 存储（可选，不填也能启动）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET_NAME=aigc-creative
QINIU_DOMAIN=
DASHSCOPE_API_KEY=
YOUTUBE_API_KEY=
